local function udim2ToTable(udim2)
    if not udim2 then return nil end
    return {
        XScale = udim2.X.Scale,
        XOffset = udim2.X.Offset,
        YScale = udim2.Y.Scale,
        YOffset = udim2.Y.Offset
    }
end

local function tableToUDim2(t)
    if not t then return nil end
    return UDim2.new(t.XScale, t.XOffset, t.YScale, t.YOffset)
end

local SaveData = {
    BatPos = nil,
    SelfPos = nil,
    Minimized = false
}

local DATA_KEY = "PugHub_SaveData_" .. game.GameId
local DATA_FILE = DATA_KEY .. ".json"

local function saveData()
    local dataToSave = {
        BatPos = SaveData.BatPos,
        SelfPos = SaveData.SelfPos,
        Minimized = SaveData.Minimized
    }
    
    local dataString = HttpService:JSONEncode(dataToSave)

    pcall(function()
        if getgenv then
            getgenv()[DATA_KEY] = dataToSave
        end
    end)

    pcall(function()
        local existing = CoreGui:FindFirstChild(DATA_KEY)
        if existing then existing:Destroy() end

        local dataStore = Instance.new("StringValue")
        dataStore.Name = DATA_KEY
        dataStore.Value = dataString
        dataStore.Parent = CoreGui
    end)

    pcall(function()
        if writefile then
            writefile(DATA_FILE, dataString)
        end
    end)
end

local function loadData()
    local loaded = false

    pcall(function()
        if getgenv and getgenv()[DATA_KEY] then
            local data = getgenv()[DATA_KEY]
            SaveData.BatPos = data.BatPos
            SaveData.SelfPos = data.SelfPos
            SaveData.Minimized = data.Minimized
            loaded = true
        end
    end)

    if loaded then return true end

    pcall(function()
        if isfile and readfile and isfile(DATA_FILE) then
            local fileData = readfile(DATA_FILE)
            local decoded = HttpService:JSONDecode(fileData)
            if decoded then
                SaveData.BatPos = decoded.BatPos
                SaveData.SelfPos = decoded.SelfPos
                SaveData.Minimized = decoded.Minimized
                loaded = true
            end
        end
    end)

    if loaded then return true end

    pcall(function()
        local store = CoreGui:FindFirstChild(DATA_KEY)
        if store and store:IsA("StringValue") then
            local decoded = HttpService:JSONDecode(store.Value)
            if decoded then
                SaveData.BatPos = decoded.BatPos
                SaveData.SelfPos = decoded.SelfPos
                SaveData.Minimized = decoded.Minimized
                loaded = true
            end
        end
    end)

    return loaded
end

loadData()

local function purge(char)
    if not char then return end
    for _,v in ipairs(char:GetChildren()) do
        if v:IsA("Accessory") then
            v:Destroy()
        end
    end
    char.ChildAdded:Connect(function(v)
        if v:IsA("Accessory") then
            task.wait()
            if v.Parent then v:Destroy() end
        end
    end)
end

