task.spawn(function()
    while true do
        if BatLagEnabled then
            local speed = tonumber(SpeedBox.Text) or 0.08
            local char = LocalPlayer.Character
            local backpack = LocalPlayer:FindFirstChild("Backpack")

            if char and backpack then
                local bat = backpack:FindFirstChild("Bat") or char:FindFirstChild("Bat")
                if bat then
                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    if humanoid and bat.Parent ~= char then
                        humanoid:EquipTool(bat)
                    end
                    task.wait(speed)
                    if bat.Parent == char then
                        bat.Parent = backpack
                    end
                else
                    task.wait(0.1)
                end
            else
                task.wait(0.1)
            end
        else
            task.wait(0.2)
        end
    end
end)

local function unequipAll()
    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid:UnequipTools() end
end

local function equip(toolName)
    unequipAll()
    task.wait(0.05)
    local char = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    local tool = backpack:FindFirstChild(toolName) or char:FindFirstChild(toolName)
    if tool then
        tool.Parent = char
        return tool
    end
    return nil
end

local function runCloneSequence(targetCFrame)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    equip("Flying Carpet")
    task.wait(0.05)
    hrp.CFrame = CFrame.new(-354.6, -7.0, 56.8)
    task.wait(0.1)
    hrp.Velocity = Vector3.new(0, 160, 0)
    task.wait(0.3)
    local southRotation = CFrame.Angles(0, math.rad(180), 0)
    hrp.CFrame = targetCFrame * southRotation
    task.wait(0.25)
    local cloner = equip("Quantum Cloner")
    if cloner then
        task.wait(0.1)
        cloner:Activate()
    end
end

