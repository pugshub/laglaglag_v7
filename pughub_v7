local function toggleVisual(state, bg, knob)
    local targetPos = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
    local targetCol = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(40, 40, 40)
    local knobCol = state and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)

    TweenService:Create(knob, TweenInfo.new(0.15), {
        Position = targetPos,
        BackgroundColor3 = knobCol
    }):Play()

    TweenService:Create(bg, TweenInfo.new(0.15), {
        BackgroundColor3 = targetCol
    }):Play()
end

